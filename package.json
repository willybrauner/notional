{
	"name": "notionalize",
	"private": true,
	"version": "0.1.0",
	"description": "Notion-like pages and databases for Obsidian: folder pages, select chips with colors, icons, board and timeline views, side peek.",
	"main": "dist/main.js",
	"type": "module",
	"scripts": {
		"dev": "tsx scripts/build.ts --watch",
		"build": "tsx scripts/build.ts --production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "vitest run --config vitest.e2e.config.ts",
		"verify": "tsx scripts/verify.ts",
		"vault:check": "tsx scripts/vault-check.ts"
	},
	"keywords": [
		"obsidian",
		"plugin",
		"notion",
		"database",
		"icons"
	],
	"author": "Willy Brauner",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/willybrauner/notionalize.git"
	},
	"bugs": {
		"url": "https://github.com/willybrauner/notionalize/issues"
	},
	"homepage": "https://github.com/willybrauner/notionalize#readme",
	"devDependencies": {
		"@codemirror/state": "^6.6.0",
		"@codemirror/view": "^6.43.0",
		"@eslint/js": "9.30.1",
		"@types/node": "^16.18.126",
		"@wbe/utils": "^0.3.2",
		"esbuild": "0.25.5",
		"eslint": "9.39.1",
		"eslint-plugin-obsidianmd": "0.6.0",
		"globals": "14.0.0",
		"happy-dom": "^21.0.4",
		"jiti": "2.6.1",
		"moment": "2.29.4",
		"obsidian": "1.12.3",
		"prettier": "^3.8.3",
		"sass": "^1.99.0",
		"tslib": "2.4.0",
		"tsx": "^4.22.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "8.35.1",
		"vitest": "^5.1.0"
	},
	"packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be"
}
